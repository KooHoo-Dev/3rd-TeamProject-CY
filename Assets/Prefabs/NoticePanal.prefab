  m_text: "\uC870\uC791\uD0A4 : A / D\n\n\uCC28\uB7C9\uC744 \uC88C \uC6B0 \uBC29\uD5A5\uC73C\uB85C
    \n\uC870\uD5A5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uB2F9\uC2E0\uC740 \uC774
    \uAC8C\uC784\uC758 \uD638\uC2A4\uD2B8\uC785\uB2C8\uB2E4!\n\uD29C\uD1A0\uB9AC\uC5BC
    \uC885\uB8CC, \uB2E4\uC2DC\uD558\uAE30 \uB4F1\n\uAC8C\uC784\uC758 \uC9C4\uD589\uACFC
